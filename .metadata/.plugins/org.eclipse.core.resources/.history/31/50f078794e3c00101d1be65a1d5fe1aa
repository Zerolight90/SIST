package am;

import java.awt.BorderLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;
import java.io.BufferedInputStream;
import java.io.BufferedOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;

import javax.swing.JFileChooser;
import javax.swing.JFrame;
import javax.swing.JMenu;
import javax.swing.JMenuBar;
import javax.swing.JMenuItem;
import javax.swing.JOptionPane;
import javax.swing.JScrollBar;
import javax.swing.JScrollPane;
import javax.swing.JTextArea;

public class Ex5_Output extends JFrame {

	JTextArea ta;
	// 메뉴에 관련된 객체들
	JMenuBar bar;
	JMenu file_menu, color_menu;
	JMenuItem new_item, open_item, save_item, exit_item;
	JMenuItem red_item, green_item, blue_item, orange_item;

	// 스트림 객체들
	BufferedInputStream bis;
	BufferedOutputStream bos;
	File selectedFile;

	public Ex5_Output() {
		ta = new JTextArea();
		this.add(new JScrollPane(ta));

		// 메뉴 작업
		new_item = new JMenuItem("새파일");
		open_item = new JMenuItem("오픈...");
		save_item = new JMenuItem("저장");
		exit_item = new JMenuItem("종료");
		// ====================

		// 서브 메뉴 작업------
		red_item = new JMenuItem("빨강");
		green_item = new JMenuItem("초록");
		blue_item = new JMenuItem("파랑");

		color_menu = new JMenu("색상");
		color_menu.add(red_item);
		color_menu.add(green_item);
		color_menu.add(blue_item);

		// --------------------

		file_menu = new JMenu("파일");
		file_menu.add(new_item);
		file_menu.add(open_item);
		file_menu.add(color_menu);
		file_menu.add(save_item);
		file_menu.addSeparator(); // 밑줄(구분선) 추가
		file_menu.add(exit_item);

		bar = new JMenuBar();
		bar.add(file_menu);

		// 메뉴바를 현재창에 추가
		this.setJMenuBar(bar);

		this.setBounds(300, 100, 600, 600);
		this.setVisible(true);

		this.addWindowListener(new WindowAdapter() {

			@Override
			public void windowClosing(WindowEvent e) {
				closed();
			}

		});

		open_item.addActionListener(new ActionListener() {

			@Override
			public void actionPerformed(ActionEvent e) {
				// [열기]를 눌렀을 때만 수행하는 곳!!
				JFileChooser jfc = new JFileChooser("c:/my_study");
				// 위와 같이 파일선택기가 생성되어도 화면에는 나타나지 않는다.
				int cmd = jfc.showOpenDialog(Ex5_Output.this);
				if (cmd == JFileChooser.APPROVE_OPTION) {
					// 사용자가 입력했던..선택한 파일을 받아낸다.
					selectedFile = jfc.getSelectedFile();

					readfile();
				}
			}
		});

		save_item.addActionListener(new ActionListener() {

			@Override
			public void actionPerformed(ActionEvent e) {
				// [저장]메뉴를 클릭했을 때만 수행

				// 선택된 파일이 null이 아니고 파일이 존재해야한다.
				if (selectedFile != null) {
					saveFile();
					System.out.println("너 왜 살아 있냐");
				} else {// 선택된 파일이 없기 때문에, 저장할 경로를 지정해야한다.
					JFileChooser jfc = new JFileChooser("c:/my_study");
					int cmd = jfc.showSaveDialog(Ex5_Output.this);
					if (cmd == JFileChooser.APPROVE_OPTION) {
						// [저장]버튼을 클릭했을 때
						// 사용자가 선택한파일 정보를 얻어내어 selectedFile에 저장
						selectedFile = jfc.getSelectedFile();

						// 파일이 이미 존재할 경우엔 덮어 쓸건지? 물어 봐야 한다.
						if(selectedFile.exists()) {
							int select = JOptionPane.showConfirmDialog(Ex5_Output.this, "덮어 쓰시겠습니까??","경고",JOptionPane.YES_NO_OPTION);
//							System.out.println(cmd+":"+JOptionPane.YES_OPTION+":"+ JOptionPane.CANCEL_OPTION);
							
							if(select != JOptionPane.YES_OPTION) {
								
								return;
							}
							selectedFile = null;
							saveFile();
						}
						
					}

				}
				
			}
		});// [저장] 메뉴 수행 종료

	}/// 기본생성자 종료

	private void readfile() {
		// 먼저 선택된 파일이 있어야 하고, 파일이 존재해야 한다.

		if (selectedFile != null && selectedFile.exists()) {
			// 읽기할 스트림 생성
			try {
				bis = new BufferedInputStream(new FileInputStream(selectedFile));

				// 읽은 수를 저장할 변수가 필요
				int size = -1;

				// 바구니 역활을 할 byte[] 필요
				byte[] buf = new byte[1024 * 8];

				StringBuffer sb = new StringBuffer();

				while ((size = bis.read(buf)) != -1) { // 반복문 size가 반복해서 돌면서 -1이 됐을떄 반복문 종료

					String str = new String(buf, 0, size); // 배열에 있는 자원들을 가져와서 문자열 객체로 생성
					sb.append(str);
				} // while문 끝
					// 모든 데이터는 sb에 적재되어 있다.
				ta.setText(sb.toString());
				this.setTitle(selectedFile.getAbsolutePath()); // 절대 경로로 제목설정
				ta.setCaretPosition(0); // 화면을 멘 위로 이동!

			} catch (Exception e) {
				e.printStackTrace(); // 오류 코드 표기
			}
		}
	}

	// 파일에 저장하는 함수
	private void saveFile() {
		if (selectedFile != null) {
			try {
				bos = new BufferedOutputStream(new FileOutputStream(selectedFile));
				//쓰기할 데이터는 JTextArea에 있다. 모두 가져 와야 한다.
				String str = ta.getText();
				
				byte[] buf = str.getBytes();
				
				bos.write(buf, 0 , buf.length);
				bos.flush();
				this.setTitle(selectedFile.getAbsolutePath());
				JOptionPane.showMessageDialog(this, "저장완료");
				

			} catch (Exception e) {
				e.printStackTrace();
			}
		}

	}// 저장 함수 종료

	private void closed() {
		// 각 스트림들 생성여부 확인 후 닫기

		try {
			if (bis != null) {
				bis.close();
			}
			if (bos != null) {
				bos.close();
			}

		} catch (Exception e) {

		}
		System.exit(0);
	}

	public static void main(String[] args) {
		// 프로그램 시작

		new Ex5_Output();

	}

}

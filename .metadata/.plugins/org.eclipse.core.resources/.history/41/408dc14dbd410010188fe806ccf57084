package pm;

import java.io.IOException;
import java.util.ArrayList;

public class ChatRoom {

		ArrayList<CopyClient> ru_list; //방에 참여한 사용자들
		String room_name;
		ChatServer server;
		
		public ChatRoom(String n, ChatServer server) {
			this.room_name =n;
			this.server = server;
			
			ru_list = new ArrayList<>();
			
		}
		
		public void sendMsg(Protocol p) { //현재 방에 접속되어 있는 모든 사용자들에게  데이터를 전달
			
			//for (int i = 0; i < ru_list.size(); i++) {
				//CopyClient cc = ru_list.get(i);

			
				for(CopyClient cc:ru_list) {
					
				try {
					cc.out.writeObject(p);
					cc.out.flush();

				} catch (IOException e) {
					// TODO Auto-generated catch block
					e.printStackTrace();
				}
			}
			
		}
		
		
		public void getOut(CopyClient cc) { //방 나가기
			ru_list.remove(cc);
			
			//만약 지금 나가는 CopyClient가 마지막 일때 현재 방은 삭제되어야 한다.
			
			
		}
		
		public void joinUser(CopyClient cc) { // 방 참여
			ru_list.add(cc);
			
			Protocol protocol = new Protocol();
			//원본 클라이언트에게 전달할 프로토콜은 다시 작업한다.
			//먼저 방에 참여한 참여자 명단 수집
			protocol.setUser_names(currentRoom.getJoinNames());
			protocol.setMsg("*** "+nickName+"님 입장 ***\r\n");
			
			//이제 준비된 프로토콜을 현재 방에 참여된 사용자들에게만 보내야한다.
			currentRoom.sendMsg(protocol);
		}
		
		//현재 방에 참여 하고 있는 사용자들의 명단
		public String[] getJoinNames() {
			String[] names = new String[ru_list.size()];
			int i =0;
			for(CopyClient cc : ru_list) {
				names[i++] = cc.getNickName(); 
			}
			return names;
		}
		
}

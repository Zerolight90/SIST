package homeWork;

import java.awt.BorderLayout;
import java.awt.FlowLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;
import java.io.BufferedInputStream;
import java.io.BufferedOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.nio.file.attribute.FileTime;
import java.util.Map;

import javax.swing.JButton;
import javax.swing.JFileChooser;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JScrollPane;
import javax.swing.JTable;
import javax.swing.JTextArea;
import javax.swing.JTextField;
import javax.swing.table.DefaultTableModel;

import am.Ex5_Output;



public class Ex9_file_info extends JFrame {

	JPanel center_p;
	JTextField url_tf;
	JButton cheek_bt;

	JTable table;
	String[] c_name = { "파일명", "수정날짜", "용량" };
	Object[][] data;

	// 파일 처리를 위한 스트림 객체들
	BufferedInputStream bis;
	BufferedOutputStream bos;
	File selectedFile;
	DefaultTableModel model;

	public Ex9_file_info() {
		center_p = new JPanel(new FlowLayout(FlowLayout.RIGHT));
		center_p.add(new JLabel("경로 : "));
		center_p.add(url_tf = new JTextField(50));
		center_p.add(cheek_bt = new JButton("검색"));
		this.add(center_p, BorderLayout.NORTH);



		this.setBounds(300, 100, 700, 800);
		this.setVisible(true);

		// 이벤트 감지자
		this.addWindowListener(new WindowAdapter() {

			@Override
			public void windowClosing(WindowEvent e) {
				System.exit(0);
			}

		});

		// 확인버튼 이벤트
		cheek_bt.addActionListener(new ActionListener() {

			@Override
			public void actionPerformed(ActionEvent e) {
				// 폴더 경로
				   String path = url_tf.getText(); // 사용자가 입력한 경로 사용

			        File f = new File(path);

			        if (f.isDirectory()) {

			            File[] sub = f.listFiles();

			            data = new String[sub.length][c_name.length];

			            for (int i = 0; i < sub.length; i++) {

			                File sub_file = sub[i];

			                try {

			                    Map<String, Object> att = Files.readAttributes(Paths.get(sub_file.getAbsolutePath()), "*");

			                    data[i][0] = sub_file.getName();

			                    FileTime ft = (FileTime) att.get("lastModifiedTime");

			                    data[i][1] = ft.toString();

			                    data[i][2] = String.valueOf(sub_file.length());

			                } catch (Exception e2) {}

			            }
			            
			
			        }

			        model = new DefaultTableModel(data, c_name); // 처음에는 null 데이터
			        table = new JTable(model);
			        Ex9_file_info.this.add(new JScrollPane(table), BorderLayout.CENTER);
			        Ex9_file_info.this.setVisible(true);
			        
			}
		});

		url_tf.addMouseListener(new MouseAdapter() {
			

			

			@Override
			public void mouseClicked(MouseEvent e) {
				// [열기]를 눌렀을 때만 수행하는 곳!!
				JFileChooser jfc = new JFileChooser("c:/my_study");
				// 위와 같이 파일선택기가 생성되어도 화면에는 나타나지 않는다.
				int cmd = jfc.showDialog(Ex9_file_info.this, "abc");
				if (cmd == JFileChooser.APPROVE_OPTION) {
					// 사용자가 입력했던..선택한 파일을 받아낸다.
					selectedFile = jfc.getSelectedFile();

					readfile();
				}
				
			}
		});
		
		

		
	}// 기본 생성자
	
	private void readfile() {
		// 먼저 선택된 파일이 있어야 하고, 파일이 존재해야 한다.

		if (selectedFile != null && selectedFile.exists()) {
			// 읽기할 스트림 생성
			try {
				bos = new BufferedOutputStream(new OutputStream() {
					
					@Override
					public void write(int b) throws IOException {
						// TODO Auto-generated method stub
						
					}
				} );

				// 읽은 수를 저장할 변수가 필요
				int size = -1;

				// 바구니 역활을 할 byte[] 필요
				byte[] buf = new byte[1024 * 8];

				StringBuffer sb = new StringBuffer();

				while ((size = bis.read(buf)) != -1) { // 반복문 size가 반복해서 돌면서 -1이 됐을떄 반복문 종료

					String str = new String(buf, 0, size); // 배열에 있는 자원들을 가져와서 문자열 객체로 생성
					sb.append(str);
				} // while문 끝
					// 모든 데이터는 sb에 적재되어 있다.
				url_tf.setText(sb.toString());
				this.setTitle(selectedFile.getAbsolutePath()); // 절대 경로로 제목설정
				url_tf.setCaretPosition(0); // 화면을 멘 위로 이동!

			} catch (Exception e) {
				e.printStackTrace(); // 오류 코드 표기
			}
		}
	}
	
	

	public static void main(String[] args) {
		new Ex9_file_info();

	}

}

package pm;

import java.io.IOException;
import java.util.ArrayList;

public class ChatRoom {

		ArrayList<CopyClient> ru_list; //방에 참여한 사용자들
		String room_name;
		
		public void sendMsg(Protocol p) { //현재 방에 접속되어 있는 모든 사용자들에게  데이터를 전달
			
			//for (int i = 0; i < ru_list.size(); i++) {
				//CopyClient cc = ru_list.get(i);

			
				for(CopyClient cc:ru_list) {
					
				try {
					cc.out.writeObject(p);
					cc.out.flush();

				} catch (IOException e) {
					// TODO Auto-generated catch block
					e.printStackTrace();
				}
			}
			
		}
		
		
		public void getOut(CopyClient cc) {
			ru_list.remove(cc);
			
		}
		
		public void joinUser(CopyClient cc) {
			ru_list.add(cc);
		}
		
}
